# Server-only. Never prefix secrets with NEXT_PUBLIC_.
# Create a key in Google AI Studio. POST /api/chat reads this name only.
# Leave it empty to keep the hero chat visibly off. The key is not sent to the browser.
GEMINI_API_KEY=

# Free flash-lite id. If this is empty or not a model id, the server uses gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternatives:
# gemini-3.1-flash-lite
# gemini-3.5-flash
# Do not use gemini-2.0-flash or gemini-2.0-flash-lite (shut down).

# Public site origin, no trailing slash. Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Optional. When BOTH are set, chat rate limiting uses Upstash (10 requests / 10 minutes / IP).
# When either is empty, the same limit is kept in process memory.
# Memory resets on restart and is not shared across server instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
