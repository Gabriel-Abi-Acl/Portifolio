# Server-only. Never prefix secrets with NEXT_PUBLIC_.
# Create a key in Google AI Studio. Unused until the chat PR.
GEMINI_API_KEY=

# Free flash-lite id for portfolio chat.
# Primary pick from the 2026-09 architecture notes (new projects should prefer 3.x).
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternatives:
# gemini-3.1-flash-lite
# gemini-3.5-flash
# gemini-2.5-flash-lite
# gemini-2.5-flash
# Do not use gemini-2.0-flash or gemini-2.0-flash-lite (shut down).

# Public site origin, no trailing slash. Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Optional rate limit (not wired in this PR).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional, only if a later PR uses @ai-sdk/google's default env name.
# GOOGLE_GENERATIVE_AI_API_KEY=
